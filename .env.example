# Copy this file to .env and fill in real values for your environment.
# Nothing in this file is read automatically in production -- set real
# environment variables there instead.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.now.sh

# Leave unset to use local SQLite (zero setup for dev).
# In production on Vercel, serverless containers have ephemeral read-only disks,
# so set DATABASE_URL to a cloud PostgreSQL database (Neon, Supabase, Vercel Postgres, etc.):
# DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
