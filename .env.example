# Copy this file to .env and fill in real values for your environment.
# Nothing in this file is read automatically in production -- set real
# environment variables there instead.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite (zero setup). Set this to switch to
# PostgreSQL, e.g. the one started by docker-compose.yml:
# DATABASE_URL=postgres://campus_journal:campus_journal@localhost:5432/campus_journal
